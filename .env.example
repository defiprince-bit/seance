# LLM provider (OpenAI-compatible; default Groq free tier)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=

# Runner adapter: onlinecompiler | selfhost | fixtures
RUNNER_KIND=onlinecompiler

# OnlineCompiler.io (when RUNNER_KIND=onlinecompiler)
ONLINECOMPILER_API_KEY=

# Self-hosted GnuCOBOL on Render (when RUNNER_KIND=selfhost)
SELFHOST_RUNNER_URL=
SELFHOST_RUNNER_TOKEN=
